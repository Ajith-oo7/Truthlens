# TruthLens environment — copy to .env and fill locally.
# Never commit .env.

# --- App ---
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://localhost:49900
DEV_BYPASS_AUTH=true
MIN_EVIDENCE_COUNT=2
CONFIDENCE_INCONCLUSIVE_BAND=0.15

# --- Gemini (required for live verdicts) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=screenshots

# --- Neo4j (docker compose default) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=truthlens
NEO4J_ENABLED=false

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ENABLED=false

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_ENABLED=false

# --- Chroma ---
CHROMA_PATH=./backend/data/chroma
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_ENABLED=false

# --- Fact check + web search ---
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=truthlens
LANGSMITH_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=truthlens-api

# --- Optional Vision OCR ---
GOOGLE_APPLICATION_CREDENTIALS=
